<Project Sdk="Microsoft.NET.Sdk">

  <!-- Evaluador manual del acierto de AnalizarEncaje (PR 6 de la F7b). Se compila en el CI, pero dotnet test nunca lo
       ejecuta: lanza claude de verdad y solo arranca con las opciones de confirmar el gasto y de tope. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo el conjunto inventado y el perfil de ejemplo: nunca el perfil real. -->
    <None Include="..\..\datos-ejemplo\encaje\*" LinkBase="datos-ejemplo\encaje" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\datos-ejemplo\perfil-ejemplo.md" Link="datos-ejemplo\perfil-ejemplo.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RadarEmpleo.Services\RadarEmpleo.Services.csproj" />
  </ItemGroup>

</Project>
