{
  "type": "object",
  "additionalProperties": false,
  "required": ["candidaturas", "dudas"],
  "properties": {
    "candidaturas": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["linea", "fecha", "fechaAproximada", "empresa", "puesto", "estado", "motivoDescarte"],
        "properties": {
          "linea": { "type": "integer", "minimum": 1 },
          "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "fechaAproximada": { "type": "boolean" },
          "empresa": { "type": "string", "minLength": 1, "maxLength": 200 },
          "puesto": { "type": "string", "minLength": 1, "maxLength": 300 },
          "estado": {
            "type": "string",
            "enum": ["Detectada", "Preparada", "Enviada", "Entrevista", "Oferta", "Descartada", "Cerrada"]
          },
          "motivoDescarte": {
            "type": ["string", "null"],
            "enum": [
              "Experiencia",
              "Ingles",
              "Titulacion",
              "Zona",
              "Modalidad",
              "Perfil",
              "Salario",
              "Cerrada",
              "DecisionPropia",
              "Otro",
              null
            ]
          }
        }
      }
    },
    "dudas": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["linea", "texto"],
        "properties": {
          "linea": { "type": ["integer", "null"], "minimum": 1 },
          "texto": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
