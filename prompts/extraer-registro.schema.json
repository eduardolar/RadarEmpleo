{
  "type": "object",
  "additionalProperties": false,
  "required": ["candidaturas", "dudas"],
  "properties": {
    "candidaturas": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seccion",
          "fecha",
          "fechaAproximada",
          "empresa",
          "puesto",
          "estado",
          "enlace",
          "modalidad",
          "ubicacion",
          "motivoDescarte",
          "nota",
          "cita"
        ],
        "properties": {
          "seccion": { "type": "string", "maxLength": 300 },
          "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "fechaAproximada": { "type": "boolean" },
          "empresa": { "type": "string", "minLength": 1, "maxLength": 200 },
          "puesto": { "type": "string", "minLength": 1, "maxLength": 300 },
          "estado": {
            "type": "string",
            "enum": ["Detectada", "Preparada", "Enviada", "Entrevista", "Oferta", "Descartada", "Cerrada"]
          },
          "enlace": { "type": ["string", "null"], "maxLength": 2000 },
          "modalidad": {
            "type": "string",
            "enum": ["NoIndicada", "Remoto", "Hibrido", "Presencial"]
          },
          "ubicacion": { "type": ["string", "null"], "maxLength": 200 },
          "motivoDescarte": {
            "type": ["string", "null"],
            "enum": [
              "Experiencia",
              "Ingles",
              "Titulacion",
              "Zona",
              "Modalidad",
              "Perfil",
              "Salario",
              "Cerrada",
              "DecisionPropia",
              "Otro",
              null
            ]
          },
          "nota": { "type": ["string", "null"], "maxLength": 5000 },
          "cita": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "dudas": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 500 }
    }
  }
}
